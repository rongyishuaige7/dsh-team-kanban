{
  "name": "dsh-team-kanban",
  "version": "0.4.3",
  "description": "A living three-column kanban board in the right sidebar for DeepSeek Harness agent teams, driven by the native agentTeam projection DAG.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kanban",
    "agent-team",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rongyishuaige7/dsh-team-kanban.git"
  },
  "homepage": "https://github.com/rongyishuaige7/dsh-team-kanban#readme",
  "bugs": {
    "url": "https://github.com/rongyishuaige7/dsh-team-kanban/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "type": "module",
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      },
      "note": "0.2.2-rc.3 desktop 已验收 T3（清空自动关闭）与 T4（流转与角标同步）；T1/T2/T5/T6 待补。0.2.1-alpha.4 的 Team 结构仅单测覆盖，未实机验证。"
    }
  }
}
